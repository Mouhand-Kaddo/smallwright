<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="dev.smallwright.permission.BIND_BUILD_WORKER" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <package android:name="dev.smallwright.generated.counter" />
        <package android:name="dev.smallwright.worker" />
        <intent>
            <action android:name="dev.smallwright.generated.PROJECT_APP" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Smallwright"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:theme="@style/Terminal"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AppReportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".OpenProjectActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".LookActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
